@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SynthTargets.cmake")

# Define the imported target
if(NOT TARGET Synth::synth_core)
    add_library(Synth::synth_core ALIAS synth_core)
endif()

# Set variables for consumers
set(SYNTH_LIBRARIES Synth::synth_core)
set(SYNTH_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include/synth")

# Platform-specific libraries
if(WIN32)
    set(SYNTH_PLATFORM_LIBS winmm)
else()
    set(SYNTH_PLATFORM_LIBS "")
endif()

check_required_components(Synth)
